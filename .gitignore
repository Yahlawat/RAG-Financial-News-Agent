# Virtual Environments
.venv/
venv/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.so

# Logs and Debug
logs/
*.log

# Data & Index Files
# Ignore everything under data/
data/*
data/**/*

# Allow .gitkeep to preserve empty folder structure
!data/chat_memory/
!data/chat_memory/.gitkeep

!data/chroma_store/
!data/chroma_store/.gitkeep

!data/processed_chunks/
!data/processed_chunks/.gitkeep

!data/raw_news/
!data/raw_news/.gitkeep

# Include all contents inside tickers/
!data/tickers/**

# Drafts & Notes
drafts/
drafts/**/*

# System Files
.DS_Store
Thumbs.db

# VSCode / IDE
.vscode/
.idea/

# Environment Files
.env
.env.*
