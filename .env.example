# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Network / Ports
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Scraping Settings
SCRAPE_TIMEOUT_PER_TICKER=180  # seconds per ticker (3 minutes)
SCRAPE_TIMEOUT_BUFFER=300  # additional buffer in seconds (5 minutes)
SCRAPE_MIN_TIMEOUT=1800  # minimum timeout in seconds (30 minutes)
AUTO_PROCESS_PIPELINE=True  # automatically run chunking + embedding after scraping

# Automated Scraping Scheduler
SCRAPE_SCHEDULE_ENABLED=True  # enable automated scheduled scraping
SCRAPE_SCHEDULE_HOUR=2  # hour (0-23) to run daily scrape (UTC)
SCRAPE_SCHEDULE_MINUTE=0  # minute (0-59) to run daily scrape

# Logging Settings
LOG_LEVEL=INFO  # Can be DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_ROTATION_DAYS=30  # Keep logs for 30 days
LOG_ENABLE_UNIFIED=True  # Enable combined.log
