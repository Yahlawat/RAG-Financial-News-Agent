# Copy this file to .env and set OPENAI_API_KEY.
# Every setting is optional except OPENAI_API_KEY; the values below are the defaults
# unless noted. Unknown keys cause a startup error, so only use settings listed in
# docs/RUNBOOK.md.

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Network / ports
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501

# Scraping: seconds after which a "running" status is treated as stale (crashed run)
SCRAPE_TIMEOUT=1800

# Daily pipeline (cleanup, scrape, chunk, embed), run by the API server.
# Disabled by default; enabled here.
SCRAPE_SCHEDULE_ENABLED=True
SCRAPE_SCHEDULE_HOUR=2  # UTC, 0-23
SCRAPE_SCHEDULE_MINUTE=0  # 0-59

# Logging
LOG_LEVEL=INFO  # API server (uvicorn) log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_ROTATION_DAYS=30  # days of rotated log files to keep
LOG_ENABLE_UNIFIED=True  # also write logs/combined.log
