# Copy this file to .env and insert your OpenAI API key
# Only OPENAI_API_KEY is required - all other settings have sensible defaults

# ========================================
# Required Settings
# ========================================
OPENAI_API_KEY=your-openai-api-key-here

# ========================================
# Optional Model Settings (defaults shown)
# ========================================
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ========================================
# Optional Network Settings (defaults shown)
# ========================================
# API_HOST=127.0.0.1
# API_PORT=8000
# STREAMLIT_PORT=8501

# ========================================
# Optional Scraping Settings (defaults shown)
# ========================================
# SCRAPE_TIMEOUT_PER_TICKER=180  # seconds per ticker (3 minutes)
# SCRAPE_TIMEOUT_BUFFER=300      # additional buffer in seconds (5 minutes)
# SCRAPE_MIN_TIMEOUT=1800        # minimum timeout in seconds (30 minutes)
# AUTO_PROCESS_PIPELINE=True     # automatically run chunking + embedding after scraping
